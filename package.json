{
  "name": "penguin-harness-apps",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:plugins": "node scripts/pack-plugin.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.workbenches.json && tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright-core": "1.61.0",
    "prettier": "3.9.4",
    "rolldown": "1.2.19",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "yaml": "2.8.4"
  }
}
